  "totalSec": 164,
  "chunks": [
    {
      "index": 0,
      "text": "यह अभ्यास दिन के अंत के लिए है।",
      "file": "c000.ogg",
      "durationSec": 6.648
    },
    {
      "index": 1,
      "text": "यदि आप कर सकते हैं तो रोशनी कम कर दें।",
      "file": "c001.ogg",
      "durationSec": 7.368
    },
    {
      "index": 2,
      "text": "सहारे के साथ लेटें या झुकें।",
      "file": "c002.ogg",
      "durationSec": 5.808
    },
    {
      "index": 3,
      "text": "दिन ख़त्म होने दीजिए, भले ही दिमाग़ अभी भी कार्यों की सूची बना रहा हो।",
      "file": "c003.ogg",
      "durationSec": 10.488
    },
    {
      "index": 4,
      "text": "आप उन्हें अभी के लिए सेट कर सकते हैं.",
      "file": "c004.ogg",
      "durationSec": 7.296
    },
    {
      "index": 5,
      "text": "चार की गिनती तक धीरे-धीरे श्वास लें।",
      "file": "c005.ogg",
      "durationSec": 6.552
    },
    {
      "index": 6,
      "text": "छह की गिनती तक सांस छोड़ें।",
      "file": "c006.ogg",
      "durationSec": 5.304
    },
    {
      "index": 7,
      "text": "दोबारा। चार अंदर, छह बाहर।",
      "file": "c007.ogg",
      "durationSec": 7.512
    },
    {
      "index": 8,
      "text": "लंबी साँस छोड़ना शरीर को बताता है कि आराम करना सुरक्षित है।",
      "file": "c008.ogg",
      "durationSec": 10.704
    },
    {
      "index": 9,
      "text": "चेहरे पर बचे हुए तनाव के लिए स्कैन करें।",
      "file": "c009.ogg",
      "durationSec": 6.888
    },
    {
      "index": 10,
      "text": "भौंह को नरम करें. जबड़े को नरम करें.",
      "file": "c010.ogg",
      "durationSec": 8.304
    },
    {
      "index": 11,
      "text": "कंधों को कानों से दूर गिराएं।",
      "file": "c011.ogg",
      "durationSec": 5.28
    },
    {
      "index": 12,
      "text": "कल्पना कीजिए कि दिन हवा के झोंके के बाद धूल की तरह जम जाता है।",
      "file": "c012.ogg",
      "durationSec": 10.584
    },
    {
      "index": 13,
      "text": "जो हुआ सो हुआ.",
      "file": "c013.ogg",
      "durationSec": 3.864
    },
    {
      "index": 14,
      "text": "जो बचता है वह सुबह तक इंतजार कर सकता है।",
      "file": "c014.ogg",
      "durationSec": 8.256
    },
    {
      "index": 15,
      "text": "महसूस करें कि गद्दा या फर्श आपको पकड़ रहा है।",
      "file": "c015.ogg",
      "durationSec": 7.968
    },
    {
      "index": 16,
      "text": "शांत सांस लें. शरीर भारी.",
      "file": "c016.ogg",
      "durationSec": 7.152
    },
    {
      "index": 17,
      "text": "नींद आती है तो आने दो।",
      "file": "c017.ogg",
      "durationSec": 5.352
    },
    {
      "index": 18,
      "text": "यदि नहीं, तो फिर भी इस कोमलता में आराम करें।",
      "file": "c018.ogg",
      "durationSec": 7.56
    },
    {
      "index": 19,
      "text": "तीन और धीमी साँसें।",
      "file": "c019.ogg",
      "durationSec": 4.728
    },
    {
      "index": 20,
      "text": "में। बाहर।",
      "file": "c020.ogg",
      "durationSec": 4.776
    },
    {
      "index": 21,
      "text": "में। बाहर।",
      "file": "c021.ogg",
      "durationSec": 4.776
    },
    {
      "index": 22,
      "text": "में। बाहर।",
      "file": "c022.ogg",
      "durationSec": 4.776
    },
    {
      "index": 23,
      "text": "दिन को शुभ रात्रि. रात को शांति.",
      "file": "c023.ogg",
