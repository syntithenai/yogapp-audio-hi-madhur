{
  "id": "morning-energy-5",
  "voiceId": "hi-madhur",
  "edgeVoice": "hi-IN-MadhurNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 394,
  "chunks": [
    {
      "index": 0,
      "text": "शुभ प्रभात।",
      "file": "c000.ogg",
      "durationSec": 3.216
    },
    {
      "index": 1,
      "text": "दिन पूरा करने के लिए एक संक्षिप्त अभ्यास में आपका स्वागत है।",
      "file": "c001.ogg",
      "durationSec": 10.152
    },
    {
      "index": 2,
      "text": "यदि बेहतर लगे तो सीधे बैठें या खड़े रहें।",
      "file": "c002.ogg",
      "durationSec": 7.368
    },
    {
      "index": 3,
      "text": "अपनी आँखों को नरम होने दें, या उन्हें बंद कर लें।",
      "file": "c003.ogg",
      "durationSec": 7.92
    },
    {
      "index": 4,
      "text": "अपने पैरों को फर्श पर महसूस करें।",
      "file": "c004.ogg",
      "durationSec": 6.072
    },
    {
      "index": 5,
      "text": "नाक से धीमी गति से सांस लें।",
      "file": "c005.ogg",
      "durationSec": 5.904
    },
    {
      "index": 6,
      "text": "और मुंह से पूरी सांस बाहर छोड़ें।",
      "file": "c006.ogg",
      "durationSec": 5.952
    },
    {
      "index": 7,
      "text": "दोबारा। नरम श्वास.",
      "file": "c007.ogg",
      "durationSec": 5.928
    },
    {
      "index": 8,
      "text": "पूरी साँस छोड़ें।",
      "file": "c008.ogg",
      "durationSec": 3.816
    },
    {
      "index": 9,
      "text": "और एक। छाती भर दो.",
      "file": "c009.ogg",
      "durationSec": 6.264
    },
    {
      "index": 10,
      "text": "बिलकुल खाली कर दो।",
      "file": "c010.ogg",
      "durationSec": 4.32
    },
    {
      "index": 11,
      "text": "[विराम:4]",
      "file": "c011.ogg",
      "durationSec": 3.36
    },
    {
      "index": 12,
      "text": "दिन की चिंता किए बिना आगे की ओर देखें।",
      "file": "c012.ogg",
      "durationSec": 7.032
    },
    {
      "index": 13,
      "text": "आपको अभी पूरे मानचित्र की आवश्यकता नहीं है.",
      "file": "c013.ogg",
      "durationSec": 8.16
    },
    {
      "index": 14,
      "text": "बस अगला ईमानदार कदम.",
      "file": "c014.ogg",
      "durationSec": 5.112
    },
    {
      "index": 15,
      "text": "[विराम:5]",
      "file": "c015.ogg",
      "durationSec": 3.456
    },
    {
      "index": 16,
      "text": "चार तक सांस लें।",
      "file": "c016.ogg",
      "durationSec": 4.2
    },
    {
      "index": 17,
      "text": "दो। तीन। चार.",
      "file": "c017.ogg",
      "durationSec": 6.912
    },
    {
      "index": 18,
      "text": "चार तक सांस छोड़ें.",
      "file": "c018.ogg",
      "durationSec": 4.272
    },
    {
      "index": 19,
      "text": "दो। तीन। चार.",
      "file": "c019.ogg",
      "durationSec": 6.912
    },
    {
      "index": 20,
      "text": "फिर से, अपनी गति से।",
      "file": "c020.ogg",
      "durationSec": 4.536
    },
    {
      "index": 21,
      "text": "[विराम:6]",
      "file": "c021.ogg",
      "durationSec": 3.312
    },
    {
      "index": 22,
      "text": "हाथों में गर्माहट महसूस करें.",
      "file": "c022.ogg",
      "durationSec": 5.592
    },
    {
      "index": 23,
      "text": "पैरों में तत्परता महसूस करें।",
      "file": "c023.ogg",
      "durationSec": 5.424
    },
    {
      "index": 24,
      "text": "[विराम:4]",
      "file": "c024.ogg",
      "durationSec": 3.36
    },
    {
      "index": 25,
      "text": "कंधों को ऊपर, पीछे और नीचे घुमाएँ।",
      "file": "c025.ogg",
      "durationSec": 6.816
    },
    {
      "index": 26,
      "text": "जबड़ा खोलो.",
      "file": "c026.ogg",
      "durationSec": 3.336
    },
    {
      "index": 27,
      "text": "पेट को नरम करें.",
      "file": "c027.ogg",
      "durationSec": 4.032
    },
    {
      "index": 28,
      "text": "शरीर में बची हुई नींद पर ध्यान दें।",
      "file": "c028.ogg",
      "durationSec": 6.456
    },
    {
      "index": 29,
      "text": "इसे दूर धकेलने की जरूरत नहीं है.",
      "file": "c029.ogg",
      "durationSec": 6.792
    },
    {
      "index": 30,
      "text": "पसलियों के किनारों में सांस लें।",
      "file": "c030.ogg",
      "durationSec": 5.376
    },
    {
      "index": 31,
      "text": "और सांस छोड़ते हुए उन्हें संकीर्ण होने दें।",
      "file": "c031.ogg",
      "durationSec": 7.224
    },
    {
      "index": 32,
      "text": "[विराम:5]",
      "file": "c032.ogg",
      "durationSec": 3.456
    },
    {
      "index": 33,
      "text": "अब सांसों में थोड़ी चमक लाएं।",
      "file": "c033.ogg",
      "durationSec": 5.472
    },
    {
      "index": 34,
      "text": "ऐसे श्वास लें जैसे कि आप अंदर से जाग रहे हों।",
      "file": "c034.ogg",
      "durationSec": 7.776
    },
    {
      "index": 35,
      "text": "कल से भारी किसी भी चीज को बाहर निकालें।",
      "file": "c035.ogg",
      "durationSec": 6.912
    },
    {
      "index": 36,
      "text": "साँस लेने की संभावना.",
      "file": "c036.ogg",
      "durationSec": 4.944
    },
    {
      "index": 37,
      "text": "साँस छोड़ें वह प्रयास जिसकी अभी आवश्यकता नहीं है।",
      "file": "c037.ogg",
      "durationSec": 9.144
    },
    {
      "index": 38,
      "text": "[विराम:4]",
      "file": "c038.ogg",
      "durationSec": 3.36
    },
    {
      "index": 39,
      "text": "एक हाथ हृदय पर रखें, या दोनों हाथों को गोद में रखें।",
      "file": "c039.ogg",
      "durationSec": 9.024
    },
    {
      "index": 40,
      "text": "चुपचाप, या बस सुनते हुए, इन वाक्यांशों को आज़माएँ।",
      "file": "c040.ogg",
      "durationSec": 8.28
    },
    {
      "index": 41,
      "text": "मैं यहां हूं।",
      "file": "c041.ogg",
      "durationSec": 3.336
    },
    {
      "index": 42,
      "text": "मैं फिर से शुरू करता हूं.",
      "file": "c042.ogg",
      "durationSec": 4.704
    },
    {
      "index": 43,
      "text": "आज सुबह के लिए मेरे पास काफी कुछ है।",
      "file": "c043.ogg",
      "durationSec": 7.488
    },
    {
      "index": 44,
      "text": "[विराम:4]",
      "file": "c044.ogg",
      "durationSec": 3.36
    },
    {
      "index": 45,
      "text": "मैं स्थिरता के साथ चलता हूँ.",
      "file": "c045.ogg",
      "durationSec": 5.4
    },
    {
      "index": 46,
      "text": "मैं स्पष्ट मन से जो आता है उसका सामना करता हूं।",
      "file": "c046.ogg",
      "durationSec": 7.848
    },
    {
      "index": 47,
      "text": "मुझे आज जगह लेने की इजाजत है.",
      "file": "c047.ogg",
      "durationSec": 6.936
    },
    {
      "index": 48,
      "text": "[विराम:5]",
      "file": "c048.ogg",
      "durationSec": 3.456
    },
    {
      "index": 49,
      "text": "मैं आज के लिए एक स्पष्ट इरादा चुनता हूं।",
      "file": "c049.ogg",
      "durationSec": 7.008
    },
    {
      "index": 50,
      "text": "यह सरल हो सकता है.",
      "file": "c050.ogg",
      "durationSec": 5.184
    },
    {
      "index": 51,
      "text": "दयालुता। केंद्र। धैर्य। ऊर्जा।",
      "file": "c051.ogg",
      "durationSec": 10.8
    },
    {
      "index": 52,
      "text": "उस शब्द को एक सांस के लिए रोक कर रखें।",
      "file": "c052.ogg",
      "durationSec": 7.08
    },
    {
      "index": 53,
      "text": "[विराम:6]",
      "file": "c053.ogg",
      "durationSec": 3.312
    },
    {
      "index": 54,
      "text": "अपने आप को सुबह उस गुणवत्ता के साथ चलते हुए देखें।",
      "file": "c054.ogg",
      "durationSec": 8.688
    },
    {
      "index": 55,
      "text": "[विराम:5]",
      "file": "c055.ogg",
      "durationSec": 3.456
    },
    {
      "index": 56,
      "text": "[विराम:5]",
      "file": "c056.ogg",
      "durationSec": 3.456
    },
    {
      "index": 57,
      "text": "उंगलियों को चौड़ा, फिर मुलायम फैलाएं।",
      "file": "c057.ogg",
      "durationSec": 6.552
    },
    {
      "index": 58,
      "text": "अगर यह सच लगता है तो मुंह के कोनों को थोड़ा ऊपर उठाएं।",
      "file": "c058.ogg",
      "durationSec": 8.952
    },
    {
      "index": 59,
      "text": "[विराम:3]",
      "file": "c059.ogg",
      "durationSec": 3.312
    },
    {
      "index": 60,
      "text": "अगली सांस लेते समय रीढ़ की हड्डी को लंबा होता हुआ महसूस करें।",
      "file": "c060.ogg",
      "durationSec": 9.696
    },
    {
      "index": 61,
      "text": "साँस छोड़ते हुए महसूस करें कि कंधे स्थिर हो गए हैं।",
      "file": "c061.ogg",
      "durationSec": 9.264
    },
    {
      "index": 62,
      "text": "एक और उज्ज्वल साँस अंदर।",
      "file": "c062.ogg",
      "durationSec": 5.256
    },
    {
      "index": 63,
      "text": "और एक लंबी, आसान सांस छोड़ें।",
      "file": "c063.ogg",
      "durationSec": 6.312
    },
    {
      "index": 64,
      "text": "उँगलियाँ हिलाओ.",
      "file": "c064.ogg",
      "durationSec": 3.48
    },
    {
      "index": 65,
      "text": "जब आप तैयार हों तो आँखें खोलें।",
      "file": "c065.ogg",
      "durationSec": 6.024
    },
    {
      "index": 66,
      "text": "इस शांत ऊर्जा को अपने दिन में ले जाएं।",
      "file": "c066.ogg",
      "durationSec": 6.552
    }
  ]
}
