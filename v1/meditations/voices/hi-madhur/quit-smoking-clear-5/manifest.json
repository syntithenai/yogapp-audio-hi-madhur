  "chunks": [
    {
      "index": 0,
      "text": "स्वागत है।",
      "file": "c000.ogg",
      "durationSec": 3.984
    },
    {
      "index": 1,
      "text": "यह स्पष्ट सांस का एक अभ्यास है।",
      "file": "c001.ogg",
      "durationSec": 7.056
    },
    {
      "index": 2,
      "text": "एक आरामदायक बैठक ढूंढें, या अगर यह बेहतर लगे तो लेट जाएं।",
      "file": "c002.ogg",
      "durationSec": 10.248
    },
    {
      "index": 3,
      "text": "हाथों को आराम से रखें।",
      "file": "c003.ogg",
      "durationSec": 5.016
    },
    {
      "index": 4,
      "text": "आंखों को नरम करें, या बंद करें।",
      "file": "c004.ogg",
      "durationSec": 6.024
    },
    {
      "index": 5,
      "text": "नाक के माध्यम से धीरे-धीरे सांस लें।",
      "file": "c005.ogg",
      "durationSec": 6.576
    },
    {
      "index": 6,
      "text": "और लंबी सांस बाहर निकालें।",
      "file": "c006.ogg",
      "durationSec": 5.568
    },
    {
      "index": 7,
      "text": "[विराम:10]",
      "file": "c007.ogg",
      "durationSec": 3.336
    },
    {
      "index": 8,
      "text": "हवा को जैसी है, उसे ध्यान में रखें।",
      "file": "c008.ogg",
      "durationSec": 6.672
    },
    {
      "index": 9,
      "text": "श्वास लेते समय ठंडी।",
      "file": "c009.ogg",
      "durationSec": 4.752
    },
    {
      "index": 10,
      "text": "श्वास छोड़ते समय गर्म।",
      "file": "c010.ogg",
      "durationSec": 4.728
    },
    {
      "index": 11,
      "text": "कोई धुआं नहीं। कोई जहर नहीं। सिर्फ सांस।",
      "file": "c011.ogg",
      "durationSec": 10.32
    },
    {
      "index": 12,
      "text": "[विराम:12]",
      "file": "c012.ogg",
      "durationSec": 3.576
    },
    {
      "index": 13,
      "text": "बिना प्रयास के छाती के फैलने का अनुभव करें।",
      "file": "c013.ogg",
      "durationSec": 7.296
    },
    {
      "index": 14,
      "text": "पसलियों के थोड़ा चौड़ा होने का अनुभव करें।",
      "file": "c014.ogg",
      "durationSec": 6.672
    },
    {
      "index": 15,
      "text": "[विराम:12]",
      "file": "c015.ogg",
      "durationSec": 3.576
    },
    {
      "index": 16,
      "text": "हृदय पर एक हाथ रखें, या दोनों हाथों को लाप पर रखें।",
      "file": "c016.ogg",
      "durationSec": 9.336
    },
    {
      "index": 17,
      "text": "एक शरीर की अनुभूति जो ठीक हो रहा है।",
      "file": "c017.ogg",
      "durationSec": 7.704
    },
    {
      "index": 18,
      "text": "फेफड़े साफ हो रहे हैं। रक्त अधिक स्वच्छ हो रहा है। सूंघने की अनुभूति दिन प्रतिदिन लौट रही है।",
      "file": "c018.ogg",
      "durationSec": 18.48
    },
    {
      "index": 19,
      "text": "[विराम:16]",
      "file": "c019.ogg",
      "durationSec": 3.576
    },
    {
      "index": 20,
      "text": "मौन रूप से इन वाक्यों का प्रयास करें, या बस सुनें।",
      "file": "c020.ogg",
      "durationSec": 8.112
    },
    {
      "index": 21,
      "text": "मेरी सांस मेरी है।",
      "file": "c021.ogg",
      "durationSec": 5.112
    },
    {
      "index": 22,
      "text": "[विराम:12]",
      "file": "c022.ogg",
      "durationSec": 3.576
    },
    {
      "index": 23,
      "text": "मैं साफ हवा का चयन करता हूँ।",
      "file": "c023.ogg",
      "durationSec": 5.568
    },
    {
      "index": 24,
      "text": "[विराम:12]",
      "file": "c024.ogg",
      "durationSec": 3.576
    },
    {
      "index": 25,
      "text": "मैं उस जहर के साथ खत्म हो गया हूँ।",
      "file": "c025.ogg",
      "durationSec": 6.288
    },
    {
      "index": 26,
      "text": "[विराम:14]",
      "file": "c026.ogg",
      "durationSec": 3.552
    },
    {
      "index": 27,
      "text": "अपने अगले सामान्य क्षण की कल्पना करें जिसमें सिगरेट न हो।",
      "file": "c027.ogg",
      "durationSec": 8.904
    },
    {
      "index": 28,
      "text": "कॉफी। एक सैर। भोजन के बाद एक विराम।",
      "file": "c028.ogg",
      "durationSec": 10.104
    },
    {
      "index": 29,
      "text": "उस क्षण में खुद को पूर्ण देखें, पहले से ही मुक्त।",
      "file": "c029.ogg",
      "durationSec": 7.608
    },
    {
      "index": 30,
      "text": "[विराम:22]",
      "file": "c030.ogg",
      "durationSec": 3.456
    },
    {
      "index": 31,
      "text": "अगर धूम्रपान की याद आए, तो उसे एक चित्र बनने दें, न कि एक योजना।",
      "file": "c031.ogg",
      "durationSec": 11.04
    },
    {
      "index": 32,
      "text": "इस श्वास में वापस आएं।",
      "file": "c032.ogg",
      "durationSec": 4.752
    },
    {
      "index": 33,
      "text": "इस उच्छवास में वापस आएं।",
      "file": "c033.ogg",
      "durationSec": 5.136
    },
    {
      "index": 34,
      "text": "[विराम:14]",
      "file": "c034.ogg",
      "durationSec": 3.552
    },
    {
      "index": 35,
      "text": "मुक्ति में सांस लें।",
      "file": "c035.ogg",
      "durationSec": 4.296
    },
    {
      "index": 36,
      "text": "पुरानी आदत की कहानी को बाहर निकालें।",
      "file": "c036.ogg",
      "durationSec": 6.648
    },
    {
      "index": 37,
      "text": "[विराम:14]",
      "file": "c037.ogg",
      "durationSec": 3.552
    },
    {
      "index": 38,
      "text": "आपने वह निर्णय लिया जो मायने रखता है।",
      "file": "c038.ogg",
      "durationSec": 7.272
    },
    {
      "index": 39,
      "text": "आपका शरीर उस सत्य के साथ आ रहा है।",
      "file": "c039.ogg",
      "durationSec": 7.128
    },
    {
      "index": 40,
      "text": "[विराम:12]",
      "file": "c040.ogg",
      "durationSec": 3.576
    },
    {
      "index": 41,
      "text": "एक और स्पष्ट सांस लें।",
      "file": "c041.ogg",
      "durationSec": 4.968
    },
    {
      "index": 42,
      "text": "और एक लंबी, आसान सांस बाहर निकालें।",
      "file": "c042.ogg",
      "durationSec": 7.392
    },
    {
      "index": 43,
      "text": "उंगलियों को हिलाएं।",
      "file": "c043.ogg",
      "durationSec": 4.176
    },
    {
      "index": 44,
      "text": "जब आप तैयार महसूस करें, तो आंखें खोलें।",
      "file": "c044.ogg",
      "durationSec": 7.512
    },
    {
      "index": 45,
      "text": "इस स्पष्ट हवा को अपने साथ ले जाएं।",
      "file": "c045.ogg",
      "durationSec": 6.36
    }
  ]
