{
  "id": "quit-smoking-free-10",
  "voiceId": "hi-madhur",
  "edgeVoice": "hi-IN-MadhurNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 360,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत है।",
      "file": "c000.ogg",
      "durationSec": 3.984
    },
    {
      "index": 1,
      "text": "यह अभ्यास आपके लिए एक गैर-धूम्रपानकर्ता के रूप में है।",
      "file": "c001.ogg",
      "durationSec": 9.768
    },
    {
      "index": 2,
      "text": "एक आरामदायक बैठक खोजें, या लेट जाएं यदि ऐसा बेहतर लगे।",
      "file": "c002.ogg",
      "durationSec": 10.176
    },
    {
      "index": 3,
      "text": "हाथों को आराम से रखें।",
      "file": "c003.ogg",
      "durationSec": 5.016
    },
    {
      "index": 4,
      "text": "आंखों को नरम करें, या बंद करें।",
      "file": "c004.ogg",
      "durationSec": 6.024
    },
    {
      "index": 5,
      "text": "धीरे से एक सांस लें।",
      "file": "c005.ogg",
      "durationSec": 4.8
    },
    {
      "index": 6,
      "text": "और लंबी सांस बाहर निकालें।",
      "file": "c006.ogg",
      "durationSec": 5.568
    },
    {
      "index": 7,
      "text": "[विराम:16]",
      "file": "c007.ogg",
      "durationSec": 3.576
    },
    {
      "index": 8,
      "text": "शरीर को समर्थित महसूस करें।",
      "file": "c008.ogg",
      "durationSec": 5.592
    },
    {
      "index": 9,
      "text": "साबित करने को कुछ नहीं। कहीं भी जल्दी करने की जरूरत नहीं।",
      "file": "c009.ogg",
      "durationSec": 10.752
    },
    {
      "index": 10,
      "text": "[विराम:16]",
      "file": "c010.ogg",
      "durationSec": 3.576
    },
    {
      "index": 11,
      "text": "हम स्वतंत्रता के स्पष्ट कथनों के साथ काम करेंगे।",
      "file": "c011.ogg",
      "durationSec": 7.92
    },
    {
      "index": 12,
      "text": "सुनें, या चुपचाप वही दोहराएं जो सच लगे।",
      "file": "c012.ogg",
      "durationSec": 7.008
    },
    {
      "index": 13,
      "text": "[विराम:18]",
      "file": "c013.ogg",
      "durationSec": 3.792
    },
    {
      "index": 14,
      "text": "मैं अब एक गैर-धूम्रपानकर्ता हूं।",
      "file": "c014.ogg",
      "durationSec": 6.216
    },
    {
      "index": 15,
      "text": "[विराम:16]",
      "file": "c015.ogg",
      "durationSec": 3.576
    },
    {
      "index": 16,
      "text": "मैं निकोटीन बीमारी से मुक्त होकर बहुत खुश हूं।",
      "file": "c016.ogg",
      "durationSec": 7.512
    },
    {
      "index": 17,
      "text": "[विराम:18]",
      "file": "c017.ogg",
      "durationSec": 3.792
    },
    {
      "index": 18,
      "text": "धूम्रपान अब मेरे जीवन या मेरी पहचान का हिस्सा नहीं है।",
      "file": "c018.ogg",
      "durationSec": 9.576
    },
    {
      "index": 19,
      "text": "[विराम:18]",
      "file": "c019.ogg",
      "durationSec": 3.792
    },
    {
      "index": 20,
      "text": "मुझे ये उत्तेजक चीजें पिछली यादों या अन्य धूम्रपानकर्ताओं को देखने के कारण मिल रही हैं।",
      "file": "c020.ogg",
      "durationSec": 13.44
    },
    {
      "index": 21,
      "text": "[विराम:18]",
      "file": "c021.ogg",
      "durationSec": 3.792
    },
    {
      "index": 22,
      "text": "ये उत्तेजक चीजें मुझे कुछ भी नहीं कर सकतीं, क्योंकि मैंने आदत की गुलामी से खुद को मुक्त कर लिया है।",
      "file": "c022.ogg",
      "durationSec": 14.592
    },
    {
      "index": 23,
      "text": "[विराम:22]",
      "file": "c023.ogg",
      "durationSec": 3.456
    },
    {
      "index": 24,
      "text": "मुझे उन सिगरेट के धूम्रपान करने वालों के लिए दुख होता है जो अभी भी अपने धूम्रपान के भ्रम में फंसे हुए हैं।",
      "file": "c024.ogg",
      "durationSec": 16.104
    },
    {
      "index": 25,
      "text": "जो निकोटीन की कमी, इच्छा और भरने के दुखद चक्र में फंसे हुए हैं।",
      "file": "c025.ogg",
      "durationSec": 11.112
    },
    {
      "index": 26,
      "text": "[विराम:18]",
      "file": "c026.ogg",
      "durationSec": 3.792
    },
    {
      "index": 27,
      "text": "मैं अब उनकी तरह दुखी नहीं हूँ।",
      "file": "c027.ogg",
      "durationSec": 5.736
    },
    {
      "index": 28,
      "text": "[विराम:14]",
      "file": "c028.ogg",
      "durationSec": 3.552
    },
    {
      "index": 29,
      "text": "अब मुझे सच्चाई पता है।",
      "file": "c029.ogg",
      "durationSec": 5.736
    },
    {
      "index": 30,
      "text": "धूम्रपान का कोई भी लाभ नहीं है।",
      "file": "c030.ogg",
      "durationSec": 6.816
    },
    {
      "index": 31,
      "text": "[विराम:18]",
      "file": "c031.ogg",
      "durationSec": 3.792
    },
    {
      "index": 32,
      "text": "मूत्र छड़ी किसी की मदद नहीं कर सकी है, और वह कभी नहीं करेगी।",
      "file": "c032.ogg",
      "durationSec": 10.104
    },
    {
      "index": 33,
      "text": "[विराम:18]",
      "file": "c033.ogg",
      "durationSec": 3.792
    },
    {
      "index": 34,
      "text": "धूम्रपान ने मेरे लिए बहुत सारी समस्याएँ पैदा की हैं।",
      "file": "c034.ogg",
      "durationSec": 9.216
    },
    {
      "index": 35,
      "text": "[विराम:14]",
      "file": "c035.ogg",
      "durationSec": 3.552
    },
    {
      "index": 36,
      "text": "मैंने अपने जीवन का सबसे अच्छा निर्णय लिया कि उस घृणित जहर का एक और पफ न लूं।",
      "file": "c036.ogg",
      "durationSec": 12.192
    },
    {
      "index": 37,
      "text": "वह निर्णय निश्चित था।",
      "file": "c037.ogg",
      "durationSec": 4.56
    },
    {
      "index": 38,
      "text": "[विराम:22]",
      "file": "c038.ogg",
      "durationSec": 3.456
    },
    {
      "index": 39,
      "text": "अब, मैं धूम्रपान के नियम का सम्मान करता हूँ।",
      "file": "c039.ogg",
      "durationSec": 7.104
    },
    {
      "index": 40,
      "text": "[विराम:18]",
      "file": "c040.ogg",
      "durationSec": 3.792
    },
    {
      "index": 41,
      "text": "अब, मेरी सभी स्थितियाँ बेहतर हो रही हैं।",
      "file": "c041.ogg",
      "durationSec": 7.512
    },
    {
      "index": 42,
      "text": "मैं अधिक खुश, स्वस्थ और अधिक आत्मविश्वासी बन रहा हूँ।",
      "file": "c042.ogg",
      "durationSec": 8.784
    },
    {
      "index": 43,
      "text": "[विराम:22]",
      "file": "c043.ogg",
      "durationSec": 3.456
    },
    {
      "index": 44,
      "text": "मैं मुक्त हूँ।",
      "file": "c044.ogg",
      "durationSec": 3.264
    },
    {
      "index": 45,
      "text": "[विराम:28]",
      "file": "c045.ogg",
      "durationSec": 3.96
    },
    {
      "index": 46,
      "text": "कुछ श्वासों के लिए उस मुक्ति में आराम करें।",
      "file": "c046.ogg",
      "durationSec": 6.888
    },
    {
      "index": 47,
      "text": "ट्रिगर पुरानी यादों के रूप में अभी भी आ सकते हैं।",
      "file": "c047.ogg",
      "durationSec": 8.4
    },
    {
      "index": 48,
      "text": "वे आपको गुलामी में वापस नहीं ला सकते।",
      "file": "c048.ogg",
      "durationSec": 6.768
    },
    {
      "index": 49,
      "text": "[विराम:36]",
      "file": "c049.ogg",
      "durationSec": 3.864
    },
    {
      "index": 50,
      "text": "मैं अब एक गैर-धूम्रपान करने वाला हूँ।",
      "file": "c050.ogg",
      "durationSec": 6.672
    },
    {
      "index": 51,
      "text": "मैं मुक्त हूँ।",
      "file": "c051.ogg",
      "durationSec": 3.264
    },
    {
      "index": 52,
      "text": "[विराम:28]",
      "file": "c052.ogg",
      "durationSec": 3.96
    },
    {
      "index": 53,
      "text": "एक और आसान सांस लें।",
      "file": "c053.ogg",
      "durationSec": 5.28
    },
    {
      "index": 54,
      "text": "उंगलियों को हिलाएं।",
      "file": "c054.ogg",
      "durationSec": 4.176
    },
    {
      "index": 55,
      "text": "जब आप तैयार हों, तो आंखें खोलें।",
      "file": "c055.ogg",
      "durationSec": 6.216
    },
    {
      "index": 56,
      "text": "इस मुक्ति को अपने साथ ले जाएं।",
      "file": "c056.ogg",
      "durationSec": 5.808
    }
  ]
}
