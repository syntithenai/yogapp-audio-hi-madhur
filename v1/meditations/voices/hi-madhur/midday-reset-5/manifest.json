  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 2.64
    },
    {
      "index": 1,
      "text": "एक आरामदायक सीट ढूंढें, या यदि बेहतर लगे तो लेट जाएं।",
      "file": "c001.ogg",
      "durationSec": 9.6
    },
    {
      "index": 2,
      "text": "हाथों को आराम दें.",
      "file": "c002.ogg",
      "durationSec": 4.32
    },
    {
      "index": 3,
      "text": "आँखें नरम करें, या उन्हें बंद कर लें।",
      "file": "c003.ogg",
      "durationSec": 6.384
    },
    {
      "index": 4,
      "text": "धीरे-धीरे सांस अंदर लें.",
      "file": "c004.ogg",
      "durationSec": 5.184
    },
    {
      "index": 5,
      "text": "और एक लंबी सांस छोड़ें.",
      "file": "c005.ogg",
      "durationSec": 5.088
    },
    {
      "index": 6,
      "text": "सुबह यहीं ख़त्म होने दो, भले ही दिन जारी रहे।",
      "file": "c006.ogg",
      "durationSec": 7.44
    },
    {
      "index": 7,
      "text": "कंधे गिरा दो.",
      "file": "c007.ogg",
      "durationSec": 3.336
    },
    {
      "index": 8,
      "text": "जबड़ा खोलो.",
      "file": "c008.ogg",
      "durationSec": 3.336
    },
    {
      "index": 9,
      "text": "[विराम:30]",
      "file": "c009.ogg",
      "durationSec": 3.432
    },
    {
      "index": 10,
      "text": "नाक से श्वास लें।",
      "file": "c010.ogg",
      "durationSec": 4.296
    },
    {
      "index": 11,
      "text": "मुंह से सांस छोड़ें, जैसे कि खिड़की पर धुंध लगा रहे हों।",
      "file": "c011.ogg",
      "durationSec": 9.0
    },
    {
      "index": 12,
      "text": "दोबारा।",
      "file": "c012.ogg",
      "durationSec": 2.976
    },
    {
      "index": 13,
      "text": "[विराम:30]",
      "file": "c013.ogg",
      "durationSec": 3.432
    },
    {
      "index": 14,
      "text": "कल्पना कीजिए कि आप जो कुछ भी ले जा रहे थे उसे रख दें।",
      "file": "c014.ogg",
      "durationSec": 9.264
    },
    {
      "index": 15,
      "text": "यह आपके बगल वाली मेज़ पर इंतज़ार कर सकता है।",
      "file": "c015.ogg",
      "durationSec": 8.688
    },
    {
      "index": 16,
      "text": "[विराम:37]",
      "file": "c016.ogg",
      "durationSec": 3.84
    },
    {
      "index": 17,
      "text": "रीढ़ की हड्डी को लंबा महसूस करें।",
      "file": "c017.ogg",
      "durationSec": 6.144
    },
    {
      "index": 18,
      "text": "पेट को नरम महसूस करें.",
      "file": "c018.ogg",
      "durationSec": 4.944
    },
    {
      "index": 19,
      "text": "[विराम:30]",
      "file": "c019.ogg",
      "durationSec": 3.432
    },
    {
      "index": 20,
      "text": "चुपचाप पूछें: अगले घंटे में क्या मायने रखता है?",
      "file": "c020.ogg",
      "durationSec": 8.328
    },
    {
      "index": 21,
      "text": "एक स्पष्ट अगला कदम ही काफी है.",
      "file": "c021.ogg",
      "durationSec": 6.672
    },
    {
      "index": 22,
      "text": "[विराम:44]",
      "file": "c022.ogg",
      "durationSec": 3.864
    },
    {
      "index": 23,
      "text": "उस सादगी में सांस लें.",
      "file": "c023.ogg",
      "durationSec": 4.92
    },
    {
      "index": 24,
      "text": "साँस बाहर छोड़ने का प्रयास करें।",
      "file": "c024.ogg",
      "durationSec": 5.856
    },
    {
      "index": 25,
      "text": "[विराम:37]",
      "file": "c025.ogg",
      "durationSec": 3.84
    },
    {
      "index": 26,
      "text": "एक और आसान साँस लें.",
      "file": "c026.ogg",
      "durationSec": 5.28
    },
    {
      "index": 27,
      "text": "उँगलियाँ हिलाओ.",
      "file": "c027.ogg",
      "durationSec": 3.48
    },
    {
      "index": 28,
      "text": "जब आप तैयार हों तो आँखें खोलें।",
      "file": "c028.ogg",
      "durationSec": 6.024
    },
    {
      "index": 29,
      "text": "इसमें से थोड़ा सा अपने साथ ले जाओ.",
      "file": "c029.ogg",
      "durationSec": 6.36
    }
  ]
}
