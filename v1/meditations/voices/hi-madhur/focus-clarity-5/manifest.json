  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 2.64
    },
    {
      "index": 1,
      "text": "एक आरामदायक सीट ढूंढें, या यदि बेहतर लगे तो लेट जाएं।",
      "file": "c001.ogg",
      "durationSec": 9.6
    },
    {
      "index": 2,
      "text": "हाथों को आराम दें.",
      "file": "c002.ogg",
      "durationSec": 4.32
    },
    {
      "index": 3,
      "text": "आँखें नरम करें, या उन्हें बंद कर लें।",
      "file": "c003.ogg",
      "durationSec": 6.384
    },
    {
      "index": 4,
      "text": "धीरे-धीरे सांस अंदर लें.",
      "file": "c004.ogg",
      "durationSec": 5.184
    },
    {
      "index": 5,
      "text": "और एक लंबी सांस छोड़ें.",
      "file": "c005.ogg",
      "durationSec": 5.088
    },
    {
      "index": 6,
      "text": "एक एंकर चुनें. नासिका छिद्र से सांस लेना, या पेट का ऊपर उठना।",
      "file": "c006.ogg",
      "durationSec": 12.384
    },
    {
      "index": 7,
      "text": "अपना ध्यान वहीं रखें.",
      "file": "c007.ogg",
      "durationSec": 4.656
    },
    {
      "index": 8,
      "text": "[विराम:23]",
      "file": "c008.ogg",
      "durationSec": 3.504
    },
    {
      "index": 9,
      "text": "जब मन भटकता है, तो ध्यान दें कि वह कहाँ गया।",
      "file": "c009.ogg",
      "durationSec": 7.728
    },
    {
      "index": 10,
      "text": "फिर लौट आओ. कृपया। साफ़-सफ़ाई से।",
      "file": "c010.ogg",
      "durationSec": 9.552
    },
    {
      "index": 11,
      "text": "[विराम:29]",
      "file": "c011.ogg",
      "durationSec": 3.72
    },
    {
      "index": 12,
      "text": "लौटना ही प्रशिक्षण है।",
      "file": "c012.ogg",
      "durationSec": 5.544
    },
    {
      "index": 13,
      "text": "श्वास लें. रहना।",
      "file": "c013.ogg",
      "durationSec": 5.736
    },
    {
      "index": 14,
      "text": "साँस छोड़ें। रहना।",
      "file": "c014.ogg",
      "durationSec": 5.88
    },
    {
      "index": 15,
      "text": "[विराम:34]",
      "file": "c015.ogg",
      "durationSec": 3.864
    },
    {
      "index": 16,
      "text": "यदि मददगार हो, तो सांसों को पांच तक गिनें, फिर दोबारा शुरू करें।",
      "file": "c016.ogg",
      "durationSec": 10.176
    },
    {
      "index": 17,
      "text": "एक।",
      "file": "c017.ogg",
      "durationSec": 2.4
    },
    {
      "index": 18,
      "text": "[विराम:17]",
      "file": "c018.ogg",
      "durationSec": 3.504
    },
    {
      "index": 19,
      "text": "दो।",
      "file": "c019.ogg",
      "durationSec": 2.328
    },
    {
      "index": 20,
      "text": "[विराम:17]",
      "file": "c020.ogg",
      "durationSec": 3.504
    },
    {
      "index": 21,
      "text": "तीन।",
      "file": "c021.ogg",
      "durationSec": 2.424
    },
    {
      "index": 22,
      "text": "[विराम:17]",
      "file": "c022.ogg",
      "durationSec": 3.504
    },
    {
      "index": 23,
      "text": "चार.",
      "file": "c023.ogg",
      "durationSec": 2.424
    },
    {
      "index": 24,
      "text": "[विराम:17]",
      "file": "c024.ogg",
      "durationSec": 3.504
    },
    {
      "index": 25,
      "text": "पाँच।",
      "file": "c025.ogg",
      "durationSec": 2.568
    },
    {
      "index": 26,
      "text": "[विराम:23]",
      "file": "c026.ogg",
      "durationSec": 3.504
    },
    {
      "index": 27,
      "text": "गिनती जारी करें.",
      "file": "c027.ogg",
      "durationSec": 4.008
    },
    {
      "index": 28,
      "text": "एक पल के लिए स्पष्ट, खुले ध्यान में विश्राम करें।",
      "file": "c028.ogg",
      "durationSec": 7.536
    },
    {
      "index": 29,
      "text": "[विराम:34]",
      "file": "c029.ogg",
      "durationSec": 3.864
    },
    {
      "index": 30,
      "text": "एक और आसान साँस लें.",
      "file": "c030.ogg",
      "durationSec": 5.28
    },
    {
      "index": 31,
      "text": "उँगलियाँ हिलाओ.",
      "file": "c031.ogg",
      "durationSec": 3.48
    },
    {
      "index": 32,
      "text": "जब आप तैयार हों तो आँखें खोलें।",
      "file": "c032.ogg",
      "durationSec": 6.024
    },
    {
      "index": 33,
      "text": "इसमें से थोड़ा सा अपने साथ ले जाओ.",
      "file": "c033.ogg",
      "durationSec": 6.36
    }
  ]
