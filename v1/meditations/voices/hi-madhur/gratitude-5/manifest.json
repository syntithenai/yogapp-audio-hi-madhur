{
  "id": "gratitude-5",
  "voiceId": "hi-madhur",
  "edgeVoice": "hi-IN-MadhurNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 173,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 2.64
    },
    {
      "index": 1,
      "text": "एक आरामदायक सीट ढूंढें, या यदि बेहतर लगे तो लेट जाएं।",
      "file": "c001.ogg",
      "durationSec": 9.6
    },
    {
      "index": 2,
      "text": "हाथों को आराम दें.",
      "file": "c002.ogg",
      "durationSec": 4.32
    },
    {
      "index": 3,
      "text": "आँखें नरम करें, या उन्हें बंद कर लें।",
      "file": "c003.ogg",
      "durationSec": 6.384
    },
    {
      "index": 4,
      "text": "धीरे-धीरे सांस अंदर लें.",
      "file": "c004.ogg",
      "durationSec": 5.184
    },
    {
      "index": 5,
      "text": "और एक लंबी सांस छोड़ें.",
      "file": "c005.ogg",
      "durationSec": 5.088
    },
    {
      "index": 6,
      "text": "एक छोटी सी बात याद रखें जिससे आपको आज या इस सप्ताह मदद मिली।",
      "file": "c006.ogg",
      "durationSec": 10.776
    },
    {
      "index": 7,
      "text": "यह सामान्य हो सकता है. गर्म पानी। एक संदेश. एक दीवार पर प्रकाश.",
      "file": "c007.ogg",
      "durationSec": 16.224
    },
    {
      "index": 8,
      "text": "[विराम:21]",
      "file": "c008.ogg",
      "durationSec": 3.816
    },
    {
      "index": 9,
      "text": "इसे जागरूकता में धीरे से पकड़ें।",
      "file": "c009.ogg",
      "durationSec": 5.64
    },
    {
      "index": 10,
      "text": "छाती या चेहरे में किसी नरमी पर ध्यान दें।",
      "file": "c010.ogg",
      "durationSec": 6.72
    },
    {
      "index": 11,
      "text": "[विराम:26]",
      "file": "c011.ogg",
      "durationSec": 3.864
    },
    {
      "index": 12,
      "text": "चुपचाप इस एक बात का शुक्रिया अदा करें.",
      "file": "c012.ogg",
      "durationSec": 6.864
    },
    {
      "index": 13,
      "text": "यहां होने के लिए धन्यवाद।",
      "file": "c013.ogg",
      "durationSec": 4.944
    },
    {
      "index": 14,
      "text": "[विराम:21]",
      "file": "c014.ogg",
      "durationSec": 3.816
    },
    {
      "index": 15,
      "text": "अब दूसरी बात. एक और छोटा सा अच्छा.",
      "file": "c015.ogg",
      "durationSec": 8.208
    },
    {
      "index": 16,
      "text": "[विराम:26]",
      "file": "c016.ogg",
      "durationSec": 3.864
    },
    {
      "index": 17,
      "text": "धन्यवाद।",
      "file": "c017.ogg",
      "durationSec": 3.048
    },
    {
      "index": 18,
      "text": "[विराम:15]",
      "file": "c018.ogg",
      "durationSec": 3.48
    },
    {
      "index": 19,
      "text": "और एक और. एक तिहाई.",
      "file": "c019.ogg",
      "durationSec": 6.408
    },
    {
      "index": 20,
      "text": "[विराम:26]",
      "file": "c020.ogg",
      "durationSec": 3.864
    },
    {
      "index": 21,
      "text": "कृतज्ञता को सरल होने दें. जबरदस्ती नहीं. बस ध्यान दो।",
      "file": "c021.ogg",
      "durationSec": 12.12
    },
    {
      "index": 22,
      "text": "[विराम:31]",
      "file": "c022.ogg",
      "durationSec": 3.816
    },
    {
      "index": 23,
      "text": "कुछ सांसों के लिए उस गर्माहट में आराम करें।",
      "file": "c023.ogg",
      "durationSec": 7.296
    },
    {
      "index": 24,
      "text": "[विराम:41]",
      "file": "c024.ogg",
      "durationSec": 4.128
    },
    {
      "index": 25,
      "text": "एक और आसान साँस लें.",
      "file": "c025.ogg",
      "durationSec": 5.28
    },
    {
      "index": 26,
      "text": "उँगलियाँ हिलाओ.",
      "file": "c026.ogg",
      "durationSec": 3.48
    },
    {
      "index": 27,
      "text": "जब आप तैयार हों तो आँखें खोलें।",
      "file": "c027.ogg",
      "durationSec": 6.024
    },
    {
      "index": 28,
      "text": "इसमें से थोड़ा सा अपने साथ ले जाओ.",
      "file": "c028.ogg",
      "durationSec": 6.36
    }
  ]
}
