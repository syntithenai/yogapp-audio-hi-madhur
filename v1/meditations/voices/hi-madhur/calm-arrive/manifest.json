  "totalSec": 130,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 2.64
    },
    {
      "index": 1,
      "text": "आने के लिए थोड़ा समय लें.",
      "file": "c001.ogg",
      "durationSec": 5.088
    },
    {
      "index": 2,
      "text": "एक आरामदायक सीट ढूंढें, या यदि बेहतर लगे तो लेट जाएं।",
      "file": "c002.ogg",
      "durationSec": 9.6
    },
    {
      "index": 3,
      "text": "अपने हाथों को आराम दें.",
      "file": "c003.ogg",
      "durationSec": 5.016
    },
    {
      "index": 4,
      "text": "अपनी आँखों को बंद होने दें, या अपनी निगाहें नरम कर लें।",
      "file": "c004.ogg",
      "durationSec": 9.048
    },
    {
      "index": 5,
      "text": "ध्यान दें कि आप यहां हैं.",
      "file": "c005.ogg",
      "durationSec": 5.88
    },
    {
      "index": 6,
      "text": "अभी ठीक करने के लिए कुछ नहीं है.",
      "file": "c006.ogg",
      "durationSec": 6.72
    },
    {
      "index": 7,
      "text": "पूरा करने के लिए कुछ भी नहीं.",
      "file": "c007.ogg",
      "durationSec": 5.28
    },
    {
      "index": 8,
      "text": "नाक से धीमी गति से सांस लें।",
      "file": "c008.ogg",
      "durationSec": 5.904
    },
    {
      "index": 9,
      "text": "और एक लंबी सांस छोड़ें.",
      "file": "c009.ogg",
      "durationSec": 5.088
    },
    {
      "index": 10,
      "text": "दोबारा। नरम श्वास.",
      "file": "c010.ogg",
      "durationSec": 5.928
    },
    {
      "index": 11,
      "text": "धीरे से साँस छोड़ें.",
      "file": "c011.ogg",
      "durationSec": 4.536
    },
    {
      "index": 12,
      "text": "अपने शरीर के भार को समर्थित महसूस करें।",
      "file": "c012.ogg",
      "durationSec": 7.08
    },
    {
      "index": 13,
      "text": "फर्श, कुर्सी, धरती तुम्हें थामे हुए है।",
      "file": "c013.ogg",
      "durationSec": 7.32
    },
    {
      "index": 14,
      "text": "यदि विचार भटकते हैं तो यह ठीक है।",
      "file": "c014.ogg",
      "durationSec": 7.512
    },
    {
      "index": 15,
      "text": "बस ध्यान दें, और इस सांस पर वापस लौटें।",
      "file": "c015.ogg",
      "durationSec": 7.632
    },
    {
      "index": 16,
      "text": "श्वास लें. आना।",
      "file": "c016.ogg",
      "durationSec": 5.616
    },
    {
      "index": 17,
      "text": "साँस छोड़ें। निपटारा करना।",
      "file": "c017.ogg",
      "durationSec": 6.888
    },
    {
      "index": 18,
      "text": "एक और आसान साँस.",
      "file": "c018.ogg",
      "durationSec": 4.44
    },
    {
      "index": 19,
      "text": "जब आप तैयार हों तो अपनी आँखें खोलें।",
      "file": "c019.ogg",
      "durationSec": 6.744
    },
    {
      "index": 20,
      "text": "इस शांति को अपने साथ रखें।",
      "file": "c020.ogg",
      "durationSec": 5.784
    }
  ]
}
