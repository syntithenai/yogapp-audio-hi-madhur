  "chunks": [
    {
      "index": 0,
      "text": "आराम से बैठो. चेहरे को मुलायम करें.",
      "file": "c000.ogg",
      "durationSec": 8.304
    },
    {
      "index": 1,
      "text": "अगर इससे मदद मिले तो दिल पर हाथ रखें।",
      "file": "c001.ogg",
      "durationSec": 6.888
    },
    {
      "index": 2,
      "text": "हम दयालुता के सरल वाक्यांश पेश करेंगे।",
      "file": "c002.ogg",
      "durationSec": 6.816
    },
    {
      "index": 3,
      "text": "सबसे पहले, अपने प्रति.",
      "file": "c003.ogg",
      "durationSec": 4.944
    },
    {
      "index": 4,
      "text": "चुपचाप मेरे पीछे दोहराओ, या बस सुनो।",
      "file": "c004.ogg",
      "durationSec": 6.696
    },
    {
      "index": 5,
      "text": "क्या मैं सुरक्षित रह सकता हूँ?",
      "file": "c005.ogg",
      "durationSec": 5.04
    },
    {
      "index": 6,
      "text": "मैं ठीक हो जाऊं.",
      "file": "c006.ogg",
      "durationSec": 3.984
    },
    {
      "index": 7,
      "text": "क्या मैं आराम से रह सकता हूँ?",
      "file": "c007.ogg",
      "durationSec": 5.016
    },
    {
      "index": 8,
      "text": "उन्हें फिर से धीरे-धीरे कहें।",
      "file": "c008.ogg",
      "durationSec": 5.136
    },
    {
      "index": 9,
      "text": "क्या मैं सुरक्षित रह सकता हूँ?",
      "file": "c009.ogg",
      "durationSec": 5.04
    },
    {
      "index": 10,
      "text": "मैं ठीक हो जाऊं.",
      "file": "c010.ogg",
      "durationSec": 3.984
